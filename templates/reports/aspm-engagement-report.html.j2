<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{{ report_title }}</title>
<style>
  :root {
    --ink: #1a1f24;
    --muted: #5b6b7a;
    --paper: #f7f5f1;
    --band: #15202b;
    --accent: #c45c26;
    --line: #d5d0c8;
    --crit: #8b1e1e;
    --high: #b54708;
    --med: #a15c07;
    --low: #3d6b4f;
    --info: #5b6b7a;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font-family: "Segoe UI", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 11pt;
    line-height: 1.45;
  }
  .cover {
    background: linear-gradient(145deg, #0f1720 0%, #243447 55%, #1b2a38 100%);
    color: #f3efe8;
    padding: 3.2rem 2.4rem 2.6rem;
    min-height: 42vh;
  }
  .cover .brand {
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-size: 0.78rem;
    opacity: 0.75;
    margin-bottom: 1.6rem;
  }
  .cover h1 {
    font-size: 2.1rem;
    font-weight: 650;
    margin: 0 0 0.6rem;
    max-width: 18ch;
    line-height: 1.15;
  }
  .cover .sub { opacity: 0.85; max-width: 42rem; margin-bottom: 1.8rem; }
  .meta-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem 1.25rem;
    font-size: 0.92rem;
  }
  .meta-grid dt { opacity: 0.65; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .meta-grid dd { margin: 0.15rem 0 0; font-family: "Segoe UI Mono", "Noto Sans Mono", monospace; }
  main { padding: 1.8rem 2.2rem 3rem; max-width: 980px; margin: 0 auto; }
  h2 { font-size: 1.25rem; margin: 2rem 0 0.75rem; border-bottom: 1px solid var(--line); padding-bottom: 0.35rem; }
  h3 { font-size: 1.05rem; margin: 1.4rem 0 0.5rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.45rem; margin: 0.8rem 0 1rem; }
  .chip {
    border-radius: 0.35rem;
    padding: 0.28rem 0.55rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
  }
  .chip.Critical { background: var(--crit); }
  .chip.High { background: var(--high); }
  .chip.Medium { background: var(--med); }
  .chip.Low { background: var(--low); }
  .chip.Info { background: var(--info); }
  .chip.ssvc { background: var(--band); }
  .chip.kev { background: #7a1f2b; }
  .chip.epss { background: #3d5a80; }
  .chip.slice { background: #4a5568; }
  .slice-note { margin: 0.75rem 0 0; max-width: 42rem; opacity: 0.9; font-size: 0.95rem; }
  .legend { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem 1.5rem; font-size: 0.92rem; }
  .legend dt { font-weight: 650; }
  .legend dd { margin: 0.1rem 0 0; color: var(--muted); }
  .toc a { color: var(--ink); text-decoration: none; border-bottom: 1px dotted var(--line); }
  .toc li { margin: 0.25rem 0; }
  .muted { color: var(--muted); }
  .dash { display: grid; grid-template-columns: 1.2fr 1fr; gap: 1.2rem; align-items: start; }
  @media (max-width: 800px) { .dash { grid-template-columns: 1fr; } .legend { grid-template-columns: 1fr; } }
  ul.risks { padding-left: 1.1rem; }
  ul.risks li { margin: 0.35rem 0; }
  footer.report-footer {
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--muted);
  }
  table.data {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
    margin: 0.6rem 0 1rem;
  }
  table.data th, table.data td {
    border-bottom: 1px solid var(--line);
    text-align: left;
    padding: 0.4rem 0.45rem;
    vertical-align: top;
  }
  table.data th { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
  tr.overdue td { background: #f8e8e4; }
  .finding-card {
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    padding: 0.75rem 0.9rem;
    margin: 0.65rem 0;
    background: #fffcf7;
    overflow: hidden;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .finding-card.overdue { border-color: #c45c26; }
  .finding-card header { margin-bottom: 0.45rem; overflow-wrap: anywhere; word-break: break-word; }
  .finding-card header strong { overflow-wrap: anywhere; word-break: break-word; }
  .finding-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.35rem 1rem;
    margin: 0.4rem 0;
    font-size: 0.88rem;
  }
  .finding-meta dt { color: var(--muted); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .finding-meta dd { margin: 0.1rem 0 0; overflow-wrap: anywhere; word-break: break-word; }
  .finding-card .desc {
    font-family: "Segoe UI Mono", "Noto Sans Mono", ui-monospace, monospace;
    font-size: 0.82rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    word-break: break-word;
    overflow: hidden;
    background: #f3f0ea;
    border-radius: 0.25rem;
    padding: 0.35rem 0.5rem;
    margin: 0.35rem 0;
  }
  .finding-card .mit { font-size: 0.9rem; margin: 0.35rem 0; overflow-wrap: anywhere; word-break: break-word; }
  code {
    font-family: "Segoe UI Mono", "Noto Sans Mono", monospace;
    font-size: 0.86em;
    overflow-wrap: anywhere;
    word-break: break-all;
    max-width: 100%;
    display: inline-block;
  }
  .finding-card a { overflow-wrap: anywhere; word-break: break-all; max-width: 100%; display: inline-block; }
  tr.heat-hot td:last-child { font-weight: 700; color: var(--high); }
  tr.heat-ok td:last-child { color: var(--low); }
  tr.heat-miss td { color: var(--muted); }
  .viz { background: #fff; border: 1px solid var(--line); border-radius: 0.4rem; padding: 0.75rem; }
  .viz-cap { margin: 0.4rem 0 0; font-size: 0.8rem; }
  table.coverage tr.heat-hot { background: #fff4ec; }
  table.coverage tr.heat-ok { background: #eef6f0; }
  table.coverage tr.heat-miss { background: #f0f0f0; }
  #owasp svg { max-width: 100%; height: auto; }
  .page-break { break-before: page; page-break-before: always; }
  details.layer {
    border: 1px solid var(--line);
    border-radius: 0.4rem;
    padding: 0.35rem 0.75rem 0.6rem;
    margin: 1rem 0;
    background: #fffcf7;
  }
  details.layer > summary {
    cursor: pointer;
    font-size: 1.05rem;
    font-weight: 650;
    padding: 0.55rem 0.15rem;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
  }
  details.layer > summary::-webkit-details-marker { display: none; }
  details.layer > summary::before {
    content: "▸";
    display: inline-block;
    width: 1ch;
    color: var(--muted);
    transition: transform 0.12s ease;
  }
  details.layer[open] > summary::before { content: "▾"; }
  details.layer > summary .chip { font-size: 0.72rem; padding: 0.15rem 0.4rem; }
  .banner.truncated {
    background: #fff4ec;
    border: 1px solid #e8c4a8;
    border-radius: 0.3rem;
    padding: 0.4rem 0.6rem;
    font-size: 0.88rem;
  }
  .finding-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.55rem;
    padding: 0.28rem 0.15rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.88rem;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .finding-row .chip { font-size: 0.7rem; padding: 0.12rem 0.35rem; }
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    margin: 0.75rem 0 0.25rem;
    font-size: 0.88rem;
  }
  .pager button {
    font: inherit;
    cursor: pointer;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 0.3rem;
    padding: 0.25rem 0.55rem;
  }
  .pager button:disabled { opacity: 0.45; cursor: default; }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 1rem;
  }
  .toolbar button {
    font: inherit;
    cursor: pointer;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 0.3rem;
    padding: 0.3rem 0.65rem;
    font-size: 0.85rem;
  }
  .toc .layer-count { color: var(--muted); font-size: 0.85em; }
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--band);
    color: #fff;
    padding: 0.4rem 0.75rem;
    z-index: 100;
  }
  .skip-link:focus { left: 0.5rem; top: 0.5rem; }
  .back-top {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 20;
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 0.35rem;
    padding: 0.4rem 0.65rem;
    font: inherit;
    font-size: 0.82rem;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,0.08);
  }
  .print-more { display: none; }
  @media print {
    body { background: #fff; }
    .cover { min-height: auto; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    main { padding: 0.5rem 0; max-width: none; }
    a { color: inherit; text-decoration: none; }
    .finding-card { break-inside: avoid; }
    details.layer { border: none; padding: 0; }
    details.layer > summary::before { content: none; }
    .pager, .toolbar, .back-top, .skip-link { display: none !important; }
    .layer-page[hidden] { display: none !important; }
    .print-more { display: block; }
  }
</style>
</head>
<body>
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="cover">
    <div class="brand">cxado ASPM · Fabrica</div>
    <h1>Отчёт по безопасности приложения</h1>
    <p class="sub">Сводка findings из DefectDojo (OSS). Точка во времени — данные на момент генерации, не живой дашборд.</p>
    {% if slice_label %}
    <div class="chips">
      <span class="chip slice">Slice: {{ slice_label }}</span>
    </div>
    <p class="slice-note">Partial control-layer report — share this file when focusing one analysis type. Full engagement report is a sibling artifact without <code>.{{ slice_label }}</code> in the name.</p>
    {% endif %}
    <dl class="meta-grid">
      <div><dt>Продукт</dt><dd>{{ product.name }}</dd></div>
      <div><dt>Engagement</dt><dd>{{ engagement.name }}</dd></div>
      <div><dt>Сгенерировано</dt><dd>{{ generated_at }}</dd></div>
      <div><dt>Build / pipeline</dt><dd>{{ engagement.build_id or "—" }}</dd></div>
      <div><dt>Branch / tag</dt><dd>{{ engagement.branch_tag or "—" }}</dd></div>
      <div><dt>Commit</dt><dd>{{ engagement.commit_hash or "—" }}</dd></div>
    </dl>
  </header>

  <main id="main-content">
    <section id="executive">
      <h2>Executive summary</h2>
      <div class="dash">
        <div>
          <p class="muted">Active findings in scope: <strong>{{ findings|length }}</strong>
            {% if min_severity and min_severity != "Info" %}
              <span class="muted">(min severity {{ min_severity }})</span>
            {% endif %}
          </p>
          <div class="chips">
            {% for sev, n in severity_counts.items() %}
              {% if n %}<span class="chip {{ sev }}">{{ sev }} {{ n }}</span>{% endif %}
            {% endfor %}
          </div>
          <div class="chips">
            {% for action, n in ssvc_counts.items() %}
              {% if n %}<span class="chip ssvc">{{ action }} {{ n }}</span>{% endif %}
            {% endfor %}
            {% if kev_count %}
              <span class="chip kev">KEV {{ kev_count }}</span>
            {% endif %}
            {% if epss_high_count %}
              <span class="chip epss">EPSS≥0.5 {{ epss_high_count }}</span>
            {% endif %}
          </div>
          <h3>Top risks</h3>
          <ul class="risks">
            {% for r in top_risks %}
            <li><strong>{{ r.severity }}</strong> — {{ r.title }} <span class="muted">({{ r.ssvc_action }}, {{ r.layer }})</span></li>
            {% else %}
            <li class="muted">No findings in scope.</li>
            {% endfor %}
          </ul>
        </div>
        <div class="viz">
          {{ severity_svg | safe }}
          <p class="muted viz-cap">Stacked severity share across in-scope findings.</p>
        </div>
      </div>
    </section>

    <section id="legend">
      <h2>Severity &amp; SLA legend</h2>
      <dl class="legend">
        <div><dt>Critical / Act</dt><dd>Immediate mitigation — suggested SLA 48 hours (SSVC-lite). CISA KEV hits force Act.</dd></div>
        <div><dt>High / Attend</dt><dd>Escalate and accelerate — suggested SLA 14 days.</dd></div>
        <div><dt>Medium / Track*</dt><dd>Next patch window — suggested SLA 60 days.</dd></div>
        <div><dt>Low–Info / Track</dt><dd>Normal cycle — suggested SLA 90 days.</dd></div>
      </dl>
    </section>

    <section id="toc" class="toc">
      <h2>Contents</h2>
      <div class="toolbar" role="toolbar" aria-label="Layer controls">
        <button type="button" id="btn-collapse-all">Collapse all</button>
        <button type="button" id="btn-expand-crit">Expand Crit+High</button>
        <button type="button" id="btn-expand-all">Expand all</button>
      </div>
      <ol>
        <li><a href="#executive">Executive summary</a></li>
        <li><a href="#poam">POA&amp;M</a></li>
        <li><a href="#endpoints">Vulnerable endpoints</a></li>
        <li><a href="#owasp">OWASP mapping</a></li>
        {% for row in layer_toc %}
        <li>
          <a href="#layer-{{ row.name }}">Control: {{ row.name }}</a>
          <span class="layer-count">({{ row.count }}{% if row.critical or row.high %} · C{{ row.critical }} H{{ row.high }}{% endif %})</span>
        </li>
        {% endfor %}
        <li><a href="#coverage">Coverage appendix</a></li>
      </ol>
    </section>

    {{ body_extra | safe }}

    <footer class="report-footer">
      Generator {{ generator_version }} · source={{ source }} · filters={{ filters_note }}
      {% if dojo_public_url %} · Dojo {{ dojo_public_url }}{% endif %}
    </footer>
  </main>
  <button type="button" class="back-top" id="back-top" hidden>↑ Top</button>
  <script>
  (function () {
    var layers = Array.prototype.slice.call(document.querySelectorAll("details.layer"));
    var prior = [];
    window.addEventListener("beforeprint", function () {
      prior = layers.map(function (el) { return el.open; });
      layers.forEach(function (el) { el.open = true; });
      document.querySelectorAll(".layer-page").forEach(function (pg) {
        if (pg.getAttribute("data-page") === "1") {
          pg.hidden = false;
        } else {
          pg.hidden = true;
        }
      });
    });
    window.addEventListener("afterprint", function () {
      layers.forEach(function (el, i) { el.open = !!prior[i]; });
    });

    document.getElementById("btn-collapse-all") && document.getElementById("btn-collapse-all").addEventListener("click", function () {
      layers.forEach(function (el) { el.open = false; });
    });
    document.getElementById("btn-expand-all") && document.getElementById("btn-expand-all").addEventListener("click", function () {
      layers.forEach(function (el) { el.open = true; });
    });
    document.getElementById("btn-expand-crit") && document.getElementById("btn-expand-crit").addEventListener("click", function () {
      layers.forEach(function (el) {
        el.open = el.getAttribute("data-has-crit-high") === "1";
      });
    });

    document.querySelectorAll("nav.pager").forEach(function (nav) {
      var details = nav.closest("details.layer");
      if (!details) return;
      var pages = Array.prototype.slice.call(details.querySelectorAll(".layer-page"));
      var n = pages.length;
      var cur = 1;
      var status = nav.querySelector(".cur");
      var prev = nav.querySelector(".pager-prev");
      var next = nav.querySelector(".pager-next");
      var all = nav.querySelector(".pager-all");
      function show(page) {
        cur = page;
        pages.forEach(function (pg) {
          var p = parseInt(pg.getAttribute("data-page"), 10);
          pg.hidden = p !== cur;
        });
        if (status) status.textContent = String(cur);
        if (prev) prev.disabled = cur <= 1;
        if (next) next.disabled = cur >= n;
      }
      if (prev) prev.addEventListener("click", function () { if (cur > 1) show(cur - 1); });
      if (next) next.addEventListener("click", function () { if (cur < n) show(cur + 1); });
      if (all) all.addEventListener("click", function () {
        pages.forEach(function (pg) { pg.hidden = false; });
        nav.hidden = true;
      });
    });

    var back = document.getElementById("back-top");
    if (back) {
      window.addEventListener("scroll", function () {
        back.hidden = window.scrollY < 480;
      });
      back.addEventListener("click", function () {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    }
  })();
  </script>
</body>
</html>
